# Neon Postgres connection string (added automatically by the Vercel Marketplace Neon integration)
DATABASE_URL=postgres://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Long random secret used to hash device ids: sha256(deviceId + RATING_SALT). Never change it after launch.
RATING_SALT=change-me-to-a-long-random-string

# Password for the admin APK. Changing it signs every admin out.
ADMIN_PASSWORD=

# Telegram Login: bot from @BotFather, with /setdomain pointing at the site domain.
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

# Google Sign-In: OAuth client ID of type "Web application" from Google Cloud Console,
# with the site address in "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Chat (Supabase project → Settings → API). Run web/db/chat.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Web push for chat messages. Keys: `npx web-push generate-vapid-keys`. Never change them after launch,
# or every subscription stops working. PUSH_WEBHOOK_SECRET must match the row in Supabase push_config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://studraspbgtu-web.vercel.app
PUSH_WEBHOOK_SECRET=

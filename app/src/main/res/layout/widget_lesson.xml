<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lesson_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lesson_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1B1E28"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8B93A7"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lesson_bar"
        android:layout_width="3dp"
        android:layout_height="32dp"
        android:background="#2A56F6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lesson_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#1B1E28"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lesson_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8B93A7"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
